{
  "name": "okf-tools",
  "version": "0.1.0",
  "description": "Tools for OKF bundles (markdown + YAML frontmatter): an OKF v0.2 §11 conformance validator, and a static-site citation-graph viewer that generates one self-contained HTML file.",
  "license": "Apache-2.0",
  "author": "jimisola <jimisola@jimisola.com>",
  "repository": "github:jimisola/okf-tools",
  "homepage": "https://github.com/jimisola/okf-tools#readme",
  "bugs": "https://github.com/jimisola/okf-tools/issues",
  "keywords": [
    "okf",
    "open-knowledge-format",
    "markdown",
    "frontmatter",
    "validator",
    "conformance",
    "linter",
    "citation-graph",
    "knowledge-graph",
    "static-site",
    "graph-viewer",
    "documentation"
  ],
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "viewer": "tsx src/cli.ts",
    "validate": "tsx src/validate-cli.ts",
    "build": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "18.0.14",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "happy-dom": "20.14.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
