{
  "name": "okf-viewer",
  "version": "0.1.0",
  "description": "Generic static-site citation-graph viewer for OKF bundles (markdown + YAML frontmatter). Generates one self-contained HTML file.",
  "license": "Apache-2.0",
  "author": "jimisola <jimisola@jimisola.com>",
  "repository": "github:jimisola/okf-viewer",
  "homepage": "https://github.com/jimisola/okf-viewer#readme",
  "bugs": "https://github.com/jimisola/okf-viewer/issues",
  "keywords": [
    "okf",
    "open-knowledge-format",
    "markdown",
    "frontmatter",
    "citation-graph",
    "knowledge-graph",
    "static-site",
    "graph-viewer",
    "documentation"
  ],
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "18.0.11",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "happy-dom": "20.11.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
